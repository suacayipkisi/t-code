  <snippet _name="incl" trigger="incl" _description='#include "..."'>
    <text languages="c;chdr;cpp;cpphdr"><![CDATA[#include "${1:header.h}"]]></text>
  </snippet>
  <snippet _name="printf" trigger="printf" _description="printf">
