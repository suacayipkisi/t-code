	$0
}]]></text>
  </snippet>
  <snippet _name="struct" trigger="struct" _description="struct">
    <text languages="rust"><![CDATA[#[derive(Debug)]
struct ${1:Name} {
	$0
}]]></text>
  </snippet>
  <snippet _name="impl" trigger="impl" _description="impl block">
