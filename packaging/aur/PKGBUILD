# Maintainer: suacayipkisi <konuki8523@gmail.com>
# Upstream release v0.3 points to this immutable commit; its Makefile VERSION is 0.3.0.
# For a new release, update pkgver and _commit, run `makepkg -g` for the source checksum,
# then regenerate metadata with `makepkg --printsrcinfo > .SRCINFO`.
pkgname=t-code
pkgver=0.3.1
pkgrel=1
pkgdesc='Lightweight C/C++ IDE: file tree, editor tabs with clangd and a shell'
arch=('x86_64')
url='https://github.com/suacayipkisi/t-code'
license=('MIT')
depends=('glib2' 'gtk4' 'gtksourceview5' 'json-glib' 'vte4' 'md4c' 'clang' 'git'
         'ttf-cascadia-code' 'hicolor-icon-theme')
makedepends=('pkgconf')
optdepends=('ripgrep: faster Search panel (falls back to grep)'
            'gdb: the debugger (F5)')
_commit=f594a9f2746292adb3a59afc26b0fcd541f899c6
_srcname="$pkgname-$_commit"
source=("$pkgname-$pkgver.tar.gz::https://codeload.github.com/suacayipkisi/t-code/tar.gz/$_commit")
sha256sums=('6a1945f37c246e2f9f3d416f6bebc5aa0e9d262461c51e82c983da98dd04a99a')

build() {
  cd "$_srcname"
  make build/t-code
}

check() {
  cd "$_srcname"
  build/t-code --version | grep -qx "t-code $pkgver"
  # The other tests open windows and need a display.
  make build/test-searchmatch build/test-detect build/test-linediff
  build/test-searchmatch
  build/test-detect
  build/test-linediff
}

package() {
  cd "$_srcname"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY.md"
}
