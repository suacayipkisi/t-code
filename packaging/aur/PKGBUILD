# Maintainer: suacayipkisi <konuki8523@gmail.com>
# The source is the v$pkgver tag's archive on GitHub. For a new release: bump pkgver, push the tag,
# then put the archive's checksum in sha256sums (`makepkg -g`) and regenerate the metadata with
# `makepkg --printsrcinfo > .SRCINFO`. packaging/build.sh cannot catch a stale checksum: it builds
# from the working tree's tarball and replaces the checksum with that one's.
pkgname=t-code
pkgver=0.3.2
pkgrel=1
pkgdesc='Lightweight C/C++ IDE: file tree, editor tabs with clangd and a shell'
arch=('x86_64')
url='https://github.com/suacayipkisi/t-code'
license=('MIT')
depends=('glib2' 'gtk4' 'gtksourceview5' 'json-glib' 'vte4' 'md4c' 'clang' 'git'
         'ttf-cascadia-code' 'hicolor-icon-theme')
makedepends=('pkgconf')
optdepends=('ripgrep: faster Search panel (falls back to grep)'
            'gdb: the debugger (F5)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('bdcff6ddc16314df3ddddd3064f09415907d87106d7d8a35a3d63a5f3c654fde')

build() {
  cd "$pkgname-$pkgver"
  make build/t-code
}

check() {
  cd "$pkgname-$pkgver"
  build/t-code --version | grep -qx "t-code $pkgver"
  # The other tests open windows and need a display.
  make build/test-searchmatch build/test-detect build/test-linediff
  build/test-searchmatch
  build/test-detect
  build/test-linediff
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY.md"
}
