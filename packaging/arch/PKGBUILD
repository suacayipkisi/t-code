# Maintainer: suacayipkisi <konuki8523@gmail.com>
pkgbase=t-code-ide
pkgname=('t-code-ide' 't-code-matlab' 't-code-octave')
pkgver=0.5.0
pkgrel=1
pkgdesc='Lightweight C/C++ IDE: file tree, editor tabs with clangd and a shell'
arch=('x86_64')
url='https://github.com/suacayipkisi/t-code'
license=('MIT')
depends=('glib2' 'gtk4' 'gtksourceview5' 'json-glib' 'vte4' 'md4c' 'clang' 'git'
         'ttf-cascadia-code' 'hicolor-icon-theme' 'librsvg')
makedepends=('pkgconf')
conflicts=('t-code')
optdepends=('ripgrep: faster Search panel (falls back to grep)'
            'gdb: the debugger (F5)'
            'mercurial: Source Control in Mercurial repositories'
            'subversion: Source Control in Subversion working copies')
# packaging/build.sh makes this tarball from the working tree
source=("t-code-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "t-code-$pkgver"
  make build/t-code
}

check() {
  cd "t-code-$pkgver"
  build/t-code --version | grep -qx "t-code $pkgver"
  # The other tests open windows and need a display.
  make build/test-searchmatch build/test-detect build/test-linediff
  build/test-searchmatch
  build/test-detect
  build/test-linediff
}

package_t-code-ide() {
  cd "t-code-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY.md"
}

package_t-code-matlab() {
  pkgdesc='MATLAB plugin for t-code: run .m files in a MATLAB session (MATLAB not included)'
  arch=('any')
  depends=("t-code-ide=$pkgver" 'python')
  optdepends=()
  conflicts=()
  cd "t-code-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install-plugin PLUGIN=matlab
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_t-code-octave() {
  pkgdesc='GNU Octave plugin for t-code: run .m files in an Octave session'
  arch=('any')
  depends=("t-code-ide=$pkgver" 'python')
  optdepends=('octave: the Octave it runs')
  conflicts=()
  cd "t-code-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install-plugin PLUGIN=octave
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
