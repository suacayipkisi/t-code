{
  "api": "tapi_1",
  "id": "pomodoro",
  "name": "Pomodoro",
  "provider": "t-code",
  "version": "0.1.1",
  "description": "A focus timer at the right of the status bar: 25 minutes of focus, then a break (a long one after every fourth), with a desktop notification when each ends. Written in C, built once with the system's C compiler.",
  "executable": "run.sh",
  "requires": [
    {
      "program": [
        "cc",
        "gcc",
        "clang"
      ],
      "for": "building the plugin once",
      "install": {
        "fedora": "sudo dnf install gcc",
        "debian": "sudo apt install gcc",
        "arch": "sudo pacman -S gcc",
        "opensuse": "sudo zypper install gcc"
      }
    },
    {
      "program": "notify-send",
      "for": "the desktop notification",
      "optional": true,
      "install": {
        "fedora": "sudo dnf install libnotify",
        "debian": "sudo apt install libnotify-bin",
        "arch": "sudo pacman -S libnotify",
        "opensuse": "sudo zypper install libnotify-tools"
      }
    }
  ],
  "commands": [
    { "id": "begin", "name": "Pomodoro: Start a Focus Session" },
    { "id": "pause", "name": "Pomodoro: Pause or Resume" },
    { "id": "stop", "name": "Pomodoro: Stop" }
  ]
}
