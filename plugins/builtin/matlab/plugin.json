{
  "api": "tapi_1",
  "id": "matlab",
  "name": "MATLAB",
  "provider": "t-code",
  "version": "0.2.0",
  "description": "Run .m files in a MATLAB session in a terminal tab (F5 too); run errors show as diagnostics. Needs MATLAB. Language server: install MathWorks' MATLAB Language Server yourself (matlab-language-server on PATH); the rest works without it.",
  "executable": "matlab_plugin.py",
  "requires": [
    {
      "program": "python3",
      "for": "running the plugin",
      "install": {
        "fedora": "sudo dnf install python3",
        "debian": "sudo apt install python3",
        "arch": "sudo pacman -S python",
        "opensuse": "sudo zypper install python3"
      }
    },
    {
      "program": "matlab",
      "for": "the MATLAB session (licensed: MathWorks' installer)"
    },
    {
      "program": "matlab-language-server",
      "for": "its language server",
      "optional": true
    }
  ],
  "permissions": ["terminal"],
  "commands": [
    { "id": "run", "name": "MATLAB: Run File" },
    { "id": "batch", "name": "MATLAB: Run File in Batch (no session)" },
    { "id": "selection", "name": "MATLAB: Run Selection" },
    { "id": "stop", "name": "MATLAB: Stop (Ctrl+C)" },
    { "id": "session", "name": "MATLAB: Open Session" },
    { "id": "restart", "name": "MATLAB: Restart Session" },
    { "id": "close", "name": "MATLAB: Close Session" }
  ],
  "run": { ".m": "run" },
  "lsp": [
    {
      "name": "matlab-ls",
      "argv": ["matlab-language-server", "--stdio"],
      "languages": ["matlab"],
      "language-id": "matlab"
    }
  ]
}
