{
  "api": "tapi_1",
  "id": "octave",
  "name": "Octave",
  "provider": "t-code",
  "version": "0.1.0",
  "description": "Run .m files in a GNU Octave session in a terminal tab (F5 too); run errors show as diagnostics.",
  "executable": "octave_plugin.py",
  "requires": [
    {
      "program": "python3",
      "for": "running the plugin",
      "install": {
        "fedora": "sudo dnf install python3",
        "debian": "sudo apt install python3",
        "arch": "sudo pacman -S python",
        "opensuse": "sudo zypper install python3"
      }
    },
    {
      "program": "octave",
      "for": "the Octave session",
      "install": {
        "fedora": "sudo dnf install octave",
        "debian": "sudo apt install octave",
        "arch": "sudo pacman -S octave",
        "opensuse": "sudo zypper install octave"
      }
    }
  ],
  "permissions": ["terminal"],
  "commands": [
    { "id": "run", "name": "Octave: Run File" },
    { "id": "batch", "name": "Octave: Run File in Batch (no session)" },
    { "id": "selection", "name": "Octave: Run Selection" },
    { "id": "stop", "name": "Octave: Stop (Ctrl+C)" },
    { "id": "session", "name": "Octave: Open Session" },
    { "id": "restart", "name": "Octave: Restart Session" },
    { "id": "close", "name": "Octave: Close Session" }
  ],
  "run": { ".m": "run" }
}
