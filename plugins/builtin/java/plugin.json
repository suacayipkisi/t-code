{
  "api": "tapi_1",
  "id": "java",
  "name": "Java",
  "provider": "t-code",
  "version": "0.2.0",
  "description": "jdtls (completion, errors, navigation, refactoring), Run, Debug (F5, through java-debug), Build, Test and Clean for Maven, Gradle and plain folders, with errors and exceptions as diagnostics; library classes open as read-only sources. Language server: run Java: Install Language Server once (downloads jdtls; needs a JDK 21+).",
  "executable": "java_plugin.py",
  "requires": [
    {
      "program": "python3",
      "for": "running the plugin",
      "install": {
        "fedora": "sudo dnf install python3",
        "debian": "sudo apt install python3",
        "arch": "sudo pacman -S python",
        "opensuse": "sudo zypper install python3"
      }
    },
    {
      "program": "java",
      "for": "jdtls and running Java (a JDK 21 or newer)",
      "install": {
        "fedora": "sudo dnf install java-21-openjdk-devel",
        "debian": "sudo apt install openjdk-21-jdk",
        "arch": "sudo pacman -S jdk21-openjdk",
        "opensuse": "sudo zypper install java-21-openjdk-devel"
      }
    }
  ],
  "start": "project",
  "permissions": ["terminal", "network", "start"],
  "commands": [
    { "id": "run", "name": "Java: Run" },
    { "id": "build", "name": "Java: Build" },
    { "id": "test", "name": "Java: Run Tests" },
    { "id": "clean", "name": "Java: Clean" },
    { "id": "stop", "name": "Java: Stop (Ctrl+C)" },
    { "id": "debug", "name": "Java: Debug (F5)" },
    { "id": "install", "name": "Java: Install Language Server (jdtls)" },
    { "id": "install-debugger", "name": "Java: Install Debugger (java-debug)" },
    { "id": "clean-workspace", "name": "Java: Clean Language Server Workspace" }
  ],
  "run": { ".java": "run" },
  "debug": { ".java": "debug" },
  "lsp": [
    {
      "name": "jdtls",
      "argv": ["t-code-jdtls"],
      "languages": ["java"],
      "language-id": "java",
      "uri-contents": { "jdt": "java/classFileContents" },
      "options": {
        "extendedClientCapabilities": {
          "classFileContentsSupport": true,
          "progressReportProvider": false,
          "resolveAdditionalTextEditsSupport": false
        },
        "settings": {
          "java": {
            "configuration": { "updateBuildConfiguration": "automatic" },
            "import": { "maven": { "enabled": true }, "gradle": { "enabled": true } },
            "autobuild": { "enabled": true },
            "maxConcurrentBuilds": 1,
            "signatureHelp": { "enabled": true },
            "format": { "enabled": true },
            "inlayHints": { "parameterNames": { "enabled": "literals" } },
            "references": { "includeDecompiledSources": false }
          }
        }
      },
      "settings": {
        "java": {
          "configuration": { "updateBuildConfiguration": "automatic" },
          "import": { "maven": { "enabled": true }, "gradle": { "enabled": true } },
          "autobuild": { "enabled": true },
          "maxConcurrentBuilds": 1,
          "signatureHelp": { "enabled": true },
          "format": { "enabled": true },
          "inlayHints": { "parameterNames": { "enabled": "literals" } },
          "references": { "includeDecompiledSources": false }
        }
      }
    }
  ]
}
