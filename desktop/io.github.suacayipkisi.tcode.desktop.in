[Desktop Entry]
Type=Application
Name=t-code
Comment=C/C++ IDE: file tree, editor tabs with clangd and a shell
Exec=@BIN@ %F
Icon=io.github.suacayipkisi.tcode
Terminal=false
Categories=Development;IDE;
MimeType=text/x-csrc;text/x-chdr;text/plain;inode/directory;
StartupWMClass=io.github.suacayipkisi.tcode
StartupNotify=true
SingleMainWindow=false
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=@BIN@ --new-window
